                <DataTable :items="detailedData.teaching.studentInternships" :columns="[
                  { key: 'index', label: 'No.' },
                  { key: 'projectname||researchtitle||title||activity', label: 'Details' },
                  { key: 'totalscore||sumscore||score', label: 'Score', center: true }
                ]" />
              </template>

              <!-- Student Projects -->
              <template v-if="detailedData?.teaching?.studentProjects?.length > 0">
