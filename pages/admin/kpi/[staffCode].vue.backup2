                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-fuchsia-100 text-fuchsia-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.research.otherAcademicWorkSchool.length }}</span>
