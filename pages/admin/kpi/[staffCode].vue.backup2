        <!-- ===== Domain 3: Academic Service ===== -->
        <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
          <div @click="toggleDomain(3)" class="p-4 border-b border-gray-200 bg-gradient-to-r from-[#7FD6D6] to-[#7c3aed] cursor-pointer hover:opacity-95 transition-opacity flex items-center justify-between">
            <div class="flex items-center gap-3">
              <h3 class="text-lg font-semibold text-white">Domain 3: Academic Service</h3>
              <span class="bg-white/20 text-white text-xs font-medium px-2 py-0.5 rounded-full">{{ academicServiceItemCount }} items</span>
            </div>
            <svg class="w-5 h-5 text-white transition-transform duration-300" :class="{ 'rotate-180': isDomainExpanded(3) }" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
          <div class="overflow-hidden transition-all duration-300" :class="isDomainExpanded(3) ? 'max-h-[8000px] opacity-100' : 'max-h-0 opacity-0'">
            <div class="p-4 space-y-6">
              <div v-if="hasAcademicServiceRawScores" class="bg-gray-50 rounded-lg p-4">
                <h4 class="font-medium text-gray-800 mb-3">Academic Service Sub-scores</h4>
                <div class="h-64"><canvas ref="academicServiceBarChart"></canvas></div>
              </div>

              <div v-if="academicServiceItemCount === 0 && !hasAcademicServiceRawScores" class="text-center py-8 text-gray-500">
                <p class="font-medium">No academic service data available</p>
              </div>

              <!-- Activities -->
              <template v-if="detailedData?.academicService?.activities?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-teal-100 text-teal-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.academicService.activities.length }}</span>
                  Academic Service Activities
                </h4>
                <div class="space-y-3">
                  <div v-for="(act, idx) in detailedData.academicService.activities" :key="idx" class="p-4 bg-gray-50 rounded-lg border border-gray-200">
                    <div class="flex items-start justify-between">
                      <div class="flex-1">
                        <p class="font-medium text-gray-900">{{ act.projecttitle || act.title || 'Untitled Activity' }}</p>
                        <p class="text-sm text-gray-600 mt-1">
                          <span class="font-medium">Budget:</span> {{ act.budgetlimit ? Number(act.budgetlimit).toLocaleString() + ' THB' : 'N/A' }}
                        </p>
                      </div>
                      <span :class="act.profitable === 0 ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800'" class="text-xs font-medium px-3 py-1 rounded-full whitespace-nowrap">
                        {{ act.profitable === 0 ? 'Non-revenue' : 'Revenue' }}
                      </span>
                    </div>
                  </div>
                </div>
              </template>

              <!-- Invited Lecturer -->
              <template v-if="detailedData?.academicService?.invitedLecturer?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-indigo-100 text-indigo-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.academicService.invitedLecturer.length }}</span>
                  Invited Lecturer / Speaker
                </h4>
                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-[#046e93]">
                      <tr>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">No.</th>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">Title</th>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">Organizing Unit</th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <tr v-for="(s, i) in detailedData.academicService.invitedLecturer" :key="i" :class="i % 2 === 1 ? 'bg-[#E8F4FC]' : ''">
                        <td class="px-3 py-2 text-sm text-gray-600">{{ i + 1 }}</td>
                        <td class="px-3 py-2 text-sm text-gray-900">{{ s.speakertitle || s.speechtitle || s.projecttitle || s.title || '-' }}</td>
                        <td class="px-3 py-2 text-sm text-gray-600">{{ s.organizingunit || s.organization || s.location || '-' }}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- ===== Domain 4: Administration ===== -->
        <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
          <div @click="toggleDomain(4)" class="p-4 border-b border-gray-200 bg-gradient-to-r from-[#7c3aed] to-[#8A8BE6] cursor-pointer hover:opacity-95 transition-opacity flex items-center justify-between">
            <div class="flex items-center gap-3">
              <h3 class="text-lg font-semibold text-white">Domain 4: Administration</h3>
              <span class="bg-white/20 text-white text-xs font-medium px-2 py-0.5 rounded-full">{{ administrationItemCount }} items</span>
            </div>
            <svg class="w-5 h-5 text-white transition-transform duration-300" :class="{ 'rotate-180': isDomainExpanded(4) }" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
          <div class="overflow-hidden transition-all duration-300" :class="isDomainExpanded(4) ? 'max-h-[8000px] opacity-100' : 'max-h-0 opacity-0'">
            <div class="p-4 space-y-6">
              <div v-if="hasAdministrationRawScores" class="bg-gray-50 rounded-lg p-4">
                <h4 class="font-medium text-gray-800 mb-3">Administration Sub-scores</h4>
                <div class="h-64"><canvas ref="administrationBarChart"></canvas></div>
              </div>

              <div v-if="administrationItemCount === 0 && !hasAdministrationRawScores" class="text-center py-8 text-gray-500">
                <p class="font-medium">No administration data available</p>
              </div>

              <!-- Curricular Committee -->
              <template v-if="detailedData?.administration?.curricularCommittee?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.administration.curricularCommittee.length }}</span>
                  Curricular Committee
                </h4>
                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-[#046e93]">
                      <tr>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">No.</th>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">Committee Name</th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <tr v-for="(c, i) in detailedData.administration.curricularCommittee" :key="i" :class="i % 2 === 1 ? 'bg-[#E8F4FC]' : ''">
                        <td class="px-3 py-2 text-sm text-gray-600">{{ i + 1 }}</td>
                        <td class="px-3 py-2 text-sm text-gray-900">{{ c.nameofcommittee || c.committee_name || c.name || '-' }}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </template>
              
              <!-- School Committee -->
              <template v-if="detailedData?.administration?.schoolCommittee?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-violet-100 text-violet-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.administration.schoolCommittee.length }}</span>
                  School Committee
                </h4>
                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-[#046e93]">
                      <tr>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">No.</th>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">Committee Name</th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <tr v-for="(c, i) in detailedData.administration.schoolCommittee" :key="i" :class="i % 2 === 1 ? 'bg-[#E8F4FC]' : ''">
                        <td class="px-3 py-2 text-sm text-gray-600">{{ i + 1 }}</td>
                        <td class="px-3 py-2 text-sm text-gray-900">{{ c.nameofcommittee || c.committee_name || c.name || '-' }}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </template>
            </div>
          </div>
        </div>

        <!-- ===== Domain 5: Arts & Culture ===== -->
        <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
          <div @click="toggleDomain(5)" class="p-4 border-b border-gray-200 bg-gradient-to-r from-[#8A8BE6] to-[#C084FC] cursor-pointer hover:opacity-95 transition-opacity flex items-center justify-between">
            <div class="flex items-center gap-3">
              <h3 class="text-lg font-semibold text-white">Domain 5: Arts & Culture Conservation</h3>
              <span class="bg-white/20 text-white text-xs font-medium px-2 py-0.5 rounded-full">{{ artsCultureItemCount }} items</span>
            </div>
            <svg class="w-5 h-5 text-white transition-transform duration-300" :class="{ 'rotate-180': isDomainExpanded(5) }" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
          <div class="overflow-hidden transition-all duration-300" :class="isDomainExpanded(5) ? 'max-h-[8000px] opacity-100' : 'max-h-0 opacity-0'">
            <div class="p-4 space-y-6">
              <div v-if="hasArtsCultureRawScores" class="bg-gray-50 rounded-lg p-4">
                <h4 class="font-medium text-gray-800 mb-3">Arts & Culture Sub-scores</h4>
                <div class="h-64"><canvas ref="artsCultureBarChart"></canvas></div>
              </div>

              <div v-if="artsCultureItemCount === 0 && !hasArtsCultureRawScores" class="text-center py-8 text-gray-500">
                <p class="font-medium">No arts & culture data available</p>
              </div>

              <!-- Self Development -->
              <template v-if="detailedData?.artsCulture?.selfDevelopment?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-pink-100 text-pink-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.artsCulture.selfDevelopment.length }}</span>
                  Self Development Activities
                </h4>
                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-[#046e93]">
                      <tr>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">No.</th>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">Activity</th>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">Type</th>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">Date</th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <tr v-for="(a, i) in detailedData.artsCulture.selfDevelopment" :key="i" :class="i % 2 === 1 ? 'bg-[#E8F4FC]' : ''">
                        <td class="px-3 py-2 text-sm text-gray-600">{{ i + 1 }}</td>
                        <td class="px-3 py-2 text-sm text-gray-900">{{ a.activity || a.activityname || a.projecttitle || '-' }}</td>
                        <td class="px-3 py-2 text-sm text-gray-600">{{ a.typename || '-' }}</td>
                        <td class="px-3 py-2 text-sm text-gray-600">{{ a.startdate || '-' }}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </template>
              
              <!-- MFU Arranged -->
              <template v-if="detailedData?.artsCulture?.mfuArranged?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-fuchsia-100 text-fuchsia-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.artsCulture.mfuArranged.length }}</span>
                  MFU Arranged Activities
                </h4>
                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-[#046e93]">
                      <tr>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">No.</th>
                        <th class="px-3 py-2 text-left text-xs font-medium text-white uppercase">Project Name</th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <tr v-for="(a, i) in detailedData.artsCulture.mfuArranged" :key="i" :class="i % 2 === 1 ? 'bg-[#E8F4FC]' : ''">
                        <td class="px-3 py-2 text-sm text-gray-600">{{ i + 1 }}</td>
                        <td class="px-3 py-2 text-sm text-gray-900">{{ a.projectname || a.project_name || a.activity || '-' }}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </template>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup lang="ts">
import { useFirebaseAuth } from '@/composables/useFirebaseAuth';
import { useKpiCache } from '@/composables/useKpiCache';
import { useEvaluationPeriods } from '@/composables/useEvaluationPeriods';
import { type LecturerKpiData } from '@/composables/useAdminKpiApi';
import Chart from "chart.js/auto";
import { computed, onMounted, ref, watch, nextTick, onUnmounted } from "vue";

definePageMeta({
  layout: false
});

// ------- DataTable helper component -------
const DataTable = defineComponent({
  props: {
    items: { type: Array as () => any[], required: true },
    columns: { type: Array as () => Array<{ key: string; label: string; center?: boolean }>, required: true }
  },
  setup(props) {
    const resolveField = (item: any, keySpec: string): string => {
      if (keySpec === 'index') return '';
      const keys = keySpec.split('||');
      for (const k of keys) {
        if (item[k] !== undefined && item[k] !== null && item[k] !== '') return String(item[k]);
      }
      return '-';
    };
    return { resolveField };
  },
  template: `
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-[#046e93]">
          <tr>
            <th v-for="col in columns" :key="col.key" class="px-3 py-2 text-xs font-medium text-white uppercase" :class="col.center ? 'text-center' : 'text-left'">{{ col.label }}</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <tr v-for="(item, idx) in items" :key="idx" :class="idx % 2 === 1 ? 'bg-[#E8F4FC]' : ''">
            <td v-for="col in columns" :key="col.key" class="px-3 py-2 text-sm" :class="[col.center ? 'text-center text-gray-600' : 'text-gray-900', col.key === 'index' ? 'text-gray-600' : '']">
              {{ col.key === 'index' ? idx + 1 : resolveField(item, col.key) }}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  `
});

const route = useRoute();
const router = useRouter();
const staffCode = computed(() => route.params.staffCode as string);

// Composables
const { user } = useFirebaseAuth();
const { cachedKpiData, hasCachedData, initializeFromStorage } = useKpiCache();
const { 
  evaluationPeriods, 
  loading: isLoadingPeriods, 
  fetchEvaluationPeriods 
} = useEvaluationPeriods();

// Evaluation period state
const selectedEvaluationPeriod = ref<number>(9);

// Initialize cache from localStorage on client-side
if (typeof window !== 'undefined') {
  initializeFromStorage();
  console.log('[staffCode] Cache initialized, has data:', cachedKpiData.value?.length || 0);
}

// State
const loading = ref(true);
const error = ref<string | null>(null);
const lecturerData = ref<LecturerKpiData | null>(null);
const detailedData = ref<any>(null);
const expandedDomains = ref<Set<number>>(new Set([1]));

// Chart refs
const overallPieChart = ref<HTMLCanvasElement | null>(null);
const domainPieChart = ref<HTMLCanvasElement | null>(null);
const teachingBarChart = ref<HTMLCanvasElement | null>(null);
const researchBarChart = ref<HTMLCanvasElement | null>(null);
const academicServiceBarChart = ref<HTMLCanvasElement | null>(null);
const administrationBarChart = ref<HTMLCanvasElement | null>(null);
const artsCultureBarChart = ref<HTMLCanvasElement | null>(null);
let overallChartInstance: Chart | null = null;
let domainChartInstance: Chart | null = null;
let teachingChartInstance: Chart | null = null;
let researchChartInstance: Chart | null = null;
let academicServiceChartInstance: Chart | null = null;
let administrationChartInstance: Chart | null = null;
let artsCultureChartInstance: Chart | null = null;

// Runtime config
const runtimeConfig = useRuntimeConfig();

const getBackendUrl = () => {
  return runtimeConfig.public.apiBase || 
         runtimeConfig.public.backendApiUrl ||
         'https://som.mlbbshop.app';
};

// Toggle domain expansion
const toggleDomain = (n: number) => {
  const s = new Set(expandedDomains.value);
  s.has(n) ? s.delete(n) : s.add(n);
  expandedDomains.value = s;
};
const isDomainExpanded = (n: number) => expandedDomains.value.has(n);

// Computed domain scores
const domainScores = computed(() => {
  if (!lecturerData.value) return { teaching: 0, research: 0, academicService: 0, administration: 0, artsCulture: 0 };
  const s = lecturerData.value.domainScores || {};
  return { teaching: s.domain1 || 0, research: s.domain2 || 0, academicService: s.domain3 || 0, administration: s.domain4 || 0, artsCulture: s.domain5 || 0 };
});

// Grouped courses
const groupedUndergraduateCourses = computed(() => groupCoursesByCourseCode(detailedData.value?.teaching?.undergraduate || []));
const groupedGraduateCourses = computed(() => groupCoursesByCourseCode(detailedData.value?.teaching?.graduate || []));

function groupCoursesByCourseCode(courses: any[]) {
  const grouped: Record<string, { coursecode: string; coursename: string; sections: string[]; totalStudents: number }> = {};
  courses.forEach(c => {
    const code = c.coursecode || 'Unknown';
    if (!grouped[code]) grouped[code] = { coursecode: code, coursename: c.coursename || '-', sections: [], totalStudents: 0 };
    if (c.section) grouped[code].sections.push(String(c.section));
    grouped[code].totalStudents += parseInt(c.totalstudent) || 0;
  });
  Object.values(grouped).forEach(g => g.sections.sort((a, b) => parseInt(a) - parseInt(b)));
  return Object.values(grouped);
}

// Extract score from raw score data
const extractScore = (data: any[]): number => {
  if (!data || data.length === 0) return 0;
  const item = data[0];
  return parseFloat(item.sumscore || item.score || item.rawscore || item.totalscore || item.scorelect || 0);
};

// Item counts
const teachingItemCount = computed(() => {
  const d = detailedData.value?.teaching;
  if (!d) return 0;
  return groupedUndergraduateCourses.value.length + groupedGraduateCourses.value.length +
    (d.studentInternships?.length || 0) + (d.studentProjects?.length || 0) +
    (d.thesisOversight?.length || 0) + (d.otherTeachingTasks?.length || 0) + (d.qualityOfWork?.length || 0);
});
const researchItemCount = computed(() => {
  const d = detailedData.value?.research;
  if (!d) return 0;
  return (d.studies?.length || 0) + (d.publications?.length || 0) + (d.textbooks?.length || 0) +
    (d.patentedInventions?.length || 0) + (d.otherAcademicWork?.length || 0) + (d.otherAcademicWorkSchool?.length || 0);
});
const academicServiceItemCount = computed(() => {
  const d = detailedData.value?.academicService;
  return (d?.activities?.length || 0) + (d?.invitedLecturer?.length || 0);
});
const administrationItemCount = computed(() => {
  const d = detailedData.value?.administration;
  return (d?.curricularCommittee?.length || 0) + (d?.schoolCommittee?.length || 0);
});
const artsCultureItemCount = computed(() => {
  const d = detailedData.value?.artsCulture;
  return (d?.selfDevelopment?.length || 0) + (d?.mfuArranged?.length || 0);
});

// Check if raw score data exists for charts
const hasTeachingRawScores = computed(() => {
  const rs = detailedData.value?.rawScores?.teaching;
  return rs && Object.values(rs).some((v: any) => v?.length > 0);
});
const hasResearchRawScores = computed(() => {
  const rs = detailedData.value?.rawScores?.research;
  return rs && Object.values(rs).some((v: any) => v?.length > 0);
});
const hasAcademicServiceRawScores = computed(() => {
  const rs = detailedData.value?.rawScores?.academicService;
  return rs && Object.values(rs).some((v: any) => v?.length > 0);
});
const hasAdministrationRawScores = computed(() => {
  const rs = detailedData.value?.rawScores?.administration;
  return rs && Object.values(rs).some((v: any) => v?.length > 0);
});
const hasArtsCultureRawScores = computed(() => {
  const rs = detailedData.value?.rawScores?.artsCulture;
  return rs && Object.values(rs).some((v: any) => v?.length > 0);
});

// Performance badge
const getPerformanceBadgeClass = (level: string) => {
  const map: Record<string, string> = { 'Excellent': 'bg-yellow-100 text-yellow-800', 'Good': 'bg-green-100 text-green-800', 'Moderate': 'bg-blue-100 text-blue-800', 'Poor': 'bg-orange-100 text-orange-800', 'Very Poor': 'bg-red-100 text-red-800' };
  return map[level] || 'bg-gray-100 text-gray-800';
};

// Firebase token
const getFirebaseToken = async (): Promise<string | null> => {
  let attempts = 0;
  while (!user.value && attempts < 30) { await new Promise(r => setTimeout(r, 200)); attempts++; }
  if (!user.value) return null;
  try { return await user.value.getIdToken(); } catch { return null; }
};

// Fetch from E-port via backend proxy
const fetchMfuData = async (endpoint: string, token: string, evaluateId: string): Promise<any[]> => {
  try {
    const url = `${getBackendUrl()}/api/mfu/${endpoint}?staffcode=${staffCode.value}&evaluateid=${evaluateId}`;
    const response = await fetch(url, { headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' } });
    if (response.ok) { const result = await response.json(); return result?.data || []; }
    return [];
  } catch (err) { console.error(`[E-port] Error ${endpoint}:`, err); return []; }
};

// Fetch ALL E-port data for all 5 domains (42 endpoints)
const fetchDetailedDomainData = async (token: string, evaluateId: string) => {
  console.log('[staffCode] Fetching ALL E-port data (42 endpoints)...');
  
  try {
    // Domain 1: Teaching (9 endpoints)
    const [ug, grad, ugRaw, gradRaw, internships, projects, thesis, otherTasks, quality] = await Promise.allSettled([
      fetchMfuData('get_Undergraduate', token, evaluateId),
      fetchMfuData('get_Graduate', token, evaluateId),
      fetchMfuData('get_UndergraduateRawscore', token, evaluateId),
      fetchMfuData('get_GraduateRawscore', token, evaluateId),
      fetchMfuData('get_StudentInternships', token, evaluateId),
      fetchMfuData('get_StudentProjects', token, evaluateId),
      fetchMfuData('get_ThesisOversightDuties', token, evaluateId),
      fetchMfuData('get_OtherTeachingTasks', token, evaluateId),
      fetchMfuData('get_QualityofWork', token, evaluateId)
    ]);

    // Domain 2: Research (9 endpoints)
    const [rStudies, rPub, rStudiesRaw, rPubRaw, articlesRaw, textbooks, patents, otherWork, otherWorkSchool] = await Promise.allSettled([
      fetchMfuData('get_ResearchStudies', token, evaluateId),
      fetchMfuData('get_ResearchPublication', token, evaluateId),
      fetchMfuData('get_ResearchStudiesRawscore', token, evaluateId),
      fetchMfuData('get_ResearchPublicationRawscore', token, evaluateId),
      fetchMfuData('get_AcademicArticlesRawscore', token, evaluateId),
      fetchMfuData('get_CompositionofTextbooks', token, evaluateId),
      fetchMfuData('get_PatentedInventions', token, evaluateId),
      fetchMfuData('get_OtherAcademicWork', token, evaluateId),
      fetchMfuData('get_OtherAcademicWorkassignedbytheSchool', token, evaluateId)
    ]);

    // Domain 3: Academic Service (7 endpoints)
    const [asAct, asInvited, asActRaw, asInvitedRaw, asExtCommRaw, asReviewerRaw, asOtherRaw] = await Promise.allSettled([
      fetchMfuData('get_AcademicServiceActivities', token, evaluateId),
      fetchMfuData('get_PerformanceasanInvitedLecturerorSpeaker', token, evaluateId),
      fetchMfuData('get_AcademicServiceActivitiesRawscore', token, evaluateId),
      fetchMfuData('get_PerformanceasanInvitedLecturerorSpeakerRawscore', token, evaluateId),
      fetchMfuData('get_ExternalCommitteeAdvisorMemberRawscore', token, evaluateId),
      fetchMfuData('get_AcademicreviewerRawscore', token, evaluateId),
      fetchMfuData('get_OtherTypesofAcademicServiceProvidedRawscore', token, evaluateId)
    ]);

    // Domain 4: Administration (10 endpoints)
    const [adCurr, adSchool, adDutyRaw, adCurrRaw, adSchoolRaw, adSchoolWgRaw, adUniWgRaw, adCourseRaw, adGuestRaw, adAcadRaw] = await Promise.allSettled([
      fetchMfuData('get_CurricularCommittee', token, evaluateId),
      fetchMfuData('get_SchoolCommittee', token, evaluateId),
      fetchMfuData('get_AdministrativedutyassignedbytheSchoolRawscore', token, evaluateId),
      fetchMfuData('get_CurricularCommitteeRawscore', token, evaluateId),
      fetchMfuData('get_SchoolCommitteeRawscore', token, evaluateId),
      fetchMfuData('get_SchoolCommitteeorCommitteeAppointedWorkingGroupRawscore', token, evaluateId),
      fetchMfuData('get_UniversityCommitteeorCommitteeAppointedWorkingGroupRawscore', token, evaluateId),
      fetchMfuData('get_CourseCoordinationRawscore', token, evaluateId),
      fetchMfuData('get_CoordinationwithaGuestLecturerRawscore', token, evaluateId),
      fetchMfuData('get_AcademicAdministrationassignedbytheSchoolorUniversityRawscore', token, evaluateId)
    ]);

    // Domain 5: Arts & Culture (7 endpoints)
    const [acSelf, acMfu, acMfuRaw, acStudDevRaw, acSelfRaw, acOrgRaw, acArtsRaw] = await Promise.allSettled([
      fetchMfuData('get_Selfdevelopment', token, evaluateId),
      fetchMfuData('get_MFUarrangedactivities', token, evaluateId),
      fetchMfuData('get_MFUarrangedactivitiesRawscore', token, evaluateId),
      fetchMfuData('get_StudentdevelopmentactivitiesRawscore', token, evaluateId),
      fetchMfuData('get_SelfdevelopmentRawscore', token, evaluateId),
      fetchMfuData('get_OrganizationdevelopmentorparticipationRawscore', token, evaluateId),
      fetchMfuData('get_ArtsandCultureConservationPerformanceRawscore', token, evaluateId)
    ]);

    const v = (p: PromiseSettledResult<any[]>) => p.status === 'fulfilled' ? p.value : [];

    detailedData.value = {
      teaching: {
        undergraduate: v(ug), graduate: v(grad),
        studentInternships: v(internships), studentProjects: v(projects),
        thesisOversight: v(thesis), otherTeachingTasks: v(otherTasks), qualityOfWork: v(quality)
      },
      research: {
        studies: v(rStudies), publications: v(rPub),
        textbooks: v(textbooks), patentedInventions: v(patents),
        otherAcademicWork: v(otherWork), otherAcademicWorkSchool: v(otherWorkSchool)
      },
      academicService: { activities: v(asAct), invitedLecturer: v(asInvited) },
      administration: { curricularCommittee: v(adCurr), schoolCommittee: v(adSchool) },
      artsCulture: { selfDevelopment: v(acSelf), mfuArranged: v(acMfu) },
      rawScores: {
        teaching: { undergraduate: v(ugRaw), graduate: v(gradRaw), studentInternships: v(internships), studentProjects: v(projects), thesisOversight: v(thesis), otherTeachingTasks: v(otherTasks) },
        research: { studies: v(rStudiesRaw), publications: v(rPubRaw), academicArticles: v(articlesRaw), textbooks: v(textbooks), patentedInventions: v(patents), otherWork: v(otherWork), otherWorkSchool: v(otherWorkSchool) },
        academicService: { activities: v(asActRaw), invitedLecturer: v(asInvitedRaw), externalCommittee: v(asExtCommRaw), academicReviewer: v(asReviewerRaw), otherService: v(asOtherRaw) },
        administration: { administrativeDuty: v(adDutyRaw), curricularCommittee: v(adCurrRaw), schoolCommittee: v(adSchoolRaw), schoolWorkingGroup: v(adSchoolWgRaw), universityWorkingGroup: v(adUniWgRaw), courseCoordination: v(adCourseRaw), guestLecturer: v(adGuestRaw), academicAdmin: v(adAcadRaw) },
        artsCulture: { mfuArranged: v(acMfuRaw), studentDevelopment: v(acStudDevRaw), selfDevelopment: v(acSelfRaw), organizationDevelopment: v(acOrgRaw), artsConservation: v(acArtsRaw) }
      }
    };
    
    console.log('[staffCode] All 42 E-port endpoints loaded successfully');
  } catch (err) {
    console.error('[staffCode] Error fetching E-port data:', err);
  }
};

// Fetch data
const fetchData = async () => {
  loading.value = true;
  error.value = null;
  const sc = staffCode.value;
  if (!sc) { error.value = 'Invalid staff code.'; loading.value = false; return; }
  
  try {
    const token = await getFirebaseToken();
    if (!token) { error.value = 'Authentication required. Please log in again.'; loading.value = false; return; }
    
    const evalPeriod = (route.query.round as string) || '9';
    
    // Try cache first
    const cached = cachedKpiData.value?.find(l => l.staffCode === sc);
    if (cached) {
      lecturerData.value = cached;
      await fetchDetailedDomainData(token, evalPeriod);
      loading.value = false;
      await nextTick();
      initAllCharts();
      return;
    }
    
    // Fetch get_Percentage from E-port via proxy
    const res = await fetch(`${getBackendUrl()}/api/mfu/get_Percentage?staffcode=${sc}&evaluateid=${evalPeriod}`, {
      headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
    });
    
    if (res.ok) {
      const result = await res.json();
      const data = result?.data || result;
      const api = Array.isArray(data) ? data[0] : data;
      
      if (api) {
        const ds = {
          domain1: parseFloat(api.domain1score) || parseFloat(api.domain1) || 0,
          domain2: parseFloat(api.domain2score) || parseFloat(api.domain2) || 0,
          domain3: parseFloat(api.domain3score) || parseFloat(api.domain3) || 0,
          domain4: parseFloat(api.domain4score) || parseFloat(api.domain4) || 0,
          domain5: parseFloat(api.domain5score) || parseFloat(api.domain5) || 0,
        };
        const dw = { 
          domain1: parseFloat(api.domain1weight) || 35, domain2: parseFloat(api.domain2weight) || 40,
          domain3: parseFloat(api.domain3weight) || 10, domain4: parseFloat(api.domain4weight) || 5, domain5: parseFloat(api.domain5weight) || 10 
        };
        const pe = {
          domain1: (ds.domain1 / 100) * dw.domain1, domain2: (ds.domain2 / 100) * dw.domain2,
          domain3: (ds.domain3 / 100) * dw.domain3, domain4: (ds.domain4 / 100) * dw.domain4, domain5: (ds.domain5 / 100) * dw.domain5,
        };
        const academicPerformance = pe.domain1 + pe.domain2 + pe.domain3;
        const behavior = pe.domain4 + pe.domain5;
        const totalScore = api['Total Score (100%)'] || (academicPerformance + behavior);
        let performanceLevel = 'Very Poor';
        if (totalScore >= 85) performanceLevel = 'Excellent';
        else if (totalScore >= 75) performanceLevel = 'Good';
        else if (totalScore >= 65) performanceLevel = 'Moderate';
        else if (totalScore >= 55) performanceLevel = 'Poor';
        
        lecturerData.value = {
          staffCode: api.staffcode || sc, staffName: api.staffname || 'Unknown',
          domainScores: ds, domainWeights: dw, domainScoreName: api.domainscorename || 'Teaching',
          domainThresholds: { domain1: parseFloat(api.domain1threshold) || 0, domain2: parseFloat(api.domain2threshold) || 0, domain3: parseFloat(api.domain3threshold) || 0, domain4: parseFloat(api.domain4threshold) || 0, domain5: parseFloat(api.domain5threshold) || 0 },
          overallPerformance: { academicPerformance, behavior, totalScore }, performanceLevel
        } as any;
        
        await fetchDetailedDomainData(token, evalPeriod);
      } else {
        throw new Error('No data found for this lecturer');
      }
    } else {
      throw new Error(`Failed to fetch: ${res.status}`);
    }
  } catch (e: any) {
    error.value = e.message || 'Failed to load data';
  } finally {
    loading.value = false;
    await nextTick();
    initAllCharts();
  }
};

// Chart initialization
const initAllCharts = () => {
  if (!lecturerData.value) return;
  
  // Overall donut
  if (overallPieChart.value) {
    if (overallChartInstance) overallChartInstance.destroy();
    const a = lecturerData.value.overallPerformance.academicPerformance;
    const b = lecturerData.value.overallPerformance.behavior;
    overallChartInstance = new Chart(overallPieChart.value, {
      type: 'doughnut',
      data: { labels: ['Academic', 'Behavior', 'Remaining'], datasets: [{ data: [a, b, Math.max(0, 100 - a - b)], backgroundColor: ['#4697b9', '#00BFFF', '#E5E7EB'], borderWidth: 0 }] },
      options: { responsive: true, maintainAspectRatio: true, cutout: '70%', plugins: { legend: { display: false } } }
    });
  }
  
  // Domain pie
  if (domainPieChart.value) {
    if (domainChartInstance) domainChartInstance.destroy();
    const s = domainScores.value;
    domainChartInstance = new Chart(domainPieChart.value, {
      type: 'pie',
      data: { labels: ['Teaching', 'Research', 'Academic Service', 'Administration', 'Arts & Culture'], datasets: [{ data: [s.teaching, s.research, s.academicService, s.administration, s.artsCulture], backgroundColor: ['#005F99', '#00BFFF', '#7FD6D6', '#7c3aed', '#C084FC'], borderWidth: 2, borderColor: '#fff' }] },
      options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: false } } }
    });
  }

  // Domain bar charts
  const makeBarChart = (canvas: HTMLCanvasElement | null, existing: Chart | null, setter: (c: Chart | null) => void, labels: string[], rawData: Record<string, any[]> | undefined, keys: string[], color: string) => {
    if (!canvas || !rawData) return;
    if (existing) existing.destroy();
    const scores = keys.map(k => extractScore(rawData[k] || []));
    if (scores.every(s => s === 0)) return;
    const inst = new Chart(canvas, {
      type: 'bar',
      data: { labels, datasets: [{ label: 'Score', data: scores, backgroundColor: color + '80', borderColor: color, borderWidth: 1, borderRadius: 4 }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true }, x: { ticks: { font: { size: 10 } } } } }
    });
    setter(inst);
  };

  makeBarChart(teachingBarChart.value, teachingChartInstance, c => { teachingChartInstance = c; },
    ['Undergraduate', 'Graduate', 'Internships', 'Projects', 'Thesis', 'Other Tasks'],
    detailedData.value?.rawScores?.teaching,
    ['undergraduate', 'graduate', 'studentInternships', 'studentProjects', 'thesisOversight', 'otherTeachingTasks'],
    '#005F99'
  );

  makeBarChart(researchBarChart.value, researchChartInstance, c => { researchChartInstance = c; },
    ['Studies', 'Publications', 'Articles', 'Textbooks', 'Patents', 'Other', 'School'],
    detailedData.value?.rawScores?.research,
    ['studies', 'publications', 'academicArticles', 'textbooks', 'patentedInventions', 'otherWork', 'otherWorkSchool'],
    '#00BFFF'
  );

  makeBarChart(academicServiceBarChart.value, academicServiceChartInstance, c => { academicServiceChartInstance = c; },
    ['Activities', 'Invited', 'External Comm.', 'Reviewer', 'Other'],
    detailedData.value?.rawScores?.academicService,
    ['activities', 'invitedLecturer', 'externalCommittee', 'academicReviewer', 'otherService'],
    '#7FD6D6'
  );

  makeBarChart(administrationBarChart.value, administrationChartInstance, c => { administrationChartInstance = c; },
    ['Admin Duty', 'Curricular', 'School', 'School WG', 'Uni WG', 'Course', 'Guest', 'Academic'],
    detailedData.value?.rawScores?.administration,
    ['administrativeDuty', 'curricularCommittee', 'schoolCommittee', 'schoolWorkingGroup', 'universityWorkingGroup', 'courseCoordination', 'guestLecturer', 'academicAdmin'],
    '#7c3aed'
  );

  makeBarChart(artsCultureBarChart.value, artsCultureChartInstance, c => { artsCultureChartInstance = c; },
    ['MFU Activities', 'Student Dev', 'Self Dev', 'Org Dev', 'Arts'],
    detailedData.value?.rawScores?.artsCulture,
    ['mfuArranged', 'studentDevelopment', 'selfDevelopment', 'organizationDevelopment', 'artsConservation'],
    '#C084FC'
  );
};

// Evaluation period change
const onEvaluationPeriodChange = () => {
  router.push({ path: route.path, query: { round: selectedEvaluationPeriod.value.toString() } });
};

// Lifecycle
onMounted(async () => {
  await fetchEvaluationPeriods();
  const roundFromUrl = route.query.round as string;
  if (roundFromUrl) selectedEvaluationPeriod.value = parseInt(roundFromUrl);
  else if (evaluationPeriods.value.length > 0) selectedEvaluationPeriod.value = evaluationPeriods.value[0].evaluateid;
  await nextTick();
  fetchData();
});

onUnmounted(() => {
  [overallChartInstance, domainChartInstance, teachingChartInstance, researchChartInstance, academicServiceChartInstance, administrationChartInstance, artsCultureChartInstance]
    .forEach(c => c?.destroy());
});

watch(() => route.params.staffCode, (v) => { if (v) fetchData(); });
watch(() => route.query.round, () => fetchData());
</script>
