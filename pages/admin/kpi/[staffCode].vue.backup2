                        <td class="px-3 py-2 text-sm text-gray-600 font-mono">{{ c.coursecode }}</td>
                        <td class="px-3 py-2 text-sm text-gray-900">{{ c.coursename }}</td>
                        <td class="px-3 py-2 text-sm text-gray-600 text-center">{{ c.sections.join(', ') }}</td>
                        <td class="px-3 py-2 text-sm text-gray-600 font-medium text-center">{{ c.totalStudents }}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
