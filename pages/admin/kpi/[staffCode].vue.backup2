              <span>Behavior: {{ lecturerData.overallPerformance.behavior.toFixed(1) }}%</span>
            </div>
          </div>
        </div>

        <!-- Domain Scores Pie Chart -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Academic Score Distribution</h3>
          <div class="flex items-center justify-center">
            <div class="w-48 h-48">
              <canvas ref="domainPieChart"></canvas>
            </div>
          </div>
          <div class="mt-4 space-y-1 text-xs">
            <div v-for="(item, key) in [
