              <!-- Quality of Work -->
              <template v-if="detailedData?.teaching?.qualityOfWork?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-green-100 text-green-800 text-xs font-medium px-2 py-1 rounded mr-2">✓</span>
