              <div v-if="researchItemCount === 0 && !hasResearchRawScores" class="text-center py-8 text-gray-500">
                <p class="font-medium">No research data available</p>
              </div>

              <!-- Research Studies -->
              <template v-if="detailedData?.research?.studies?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-teal-100 text-teal-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.research.studies.length }}</span>
                  Research Studies
                </h4>
                <DataTable :items="detailedData.research.studies" :columns="[
                  { key: 'index', label: 'No.' },
                  { key: 'level', label: 'Level', center: true },
                  { key: 'researchtitle||projectname||title', label: 'Research Title' }
                ]" />
              </template>

              <!-- Research Publications -->
              <template v-if="detailedData?.research?.publications?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-cyan-100 text-cyan-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.research.publications.length }}</span>
                  Research Publications
                </h4>
                <DataTable :items="detailedData.research.publications" :columns="[
                  { key: 'index', label: 'No.' },
                  { key: 'level', label: 'Level', center: true },
                  { key: 'researchtitle||publicationtitle||title', label: 'Publication Title' }
                ]" />
              </template>

              <!-- Textbooks -->
              <template v-if="detailedData?.research?.textbooks?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-amber-100 text-amber-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.research.textbooks.length }}</span>
                  Textbooks / Books / e-Learning Materials
                </h4>
                <DataTable :items="detailedData.research.textbooks" :columns="[
                  { key: 'index', label: 'No.' },
                  { key: 'researchtitle||title||projectname', label: 'Title' },
                  { key: 'sumscore||totalscore||score', label: 'Score', center: true }
                ]" />
              </template>

              <!-- Patented Inventions -->
              <template v-if="detailedData?.research?.patentedInventions?.length > 0">
                <h4 class="font-medium text-gray-800 flex items-center">
                  <span class="bg-violet-100 text-violet-800 text-xs font-medium px-2 py-1 rounded mr-2">{{ detailedData.research.patentedInventions.length }}</span>
                  Patented Inventions
                </h4>
                <DataTable :items="detailedData.research.patentedInventions" :columns="[
                  { key: 'index', label: 'No.' },
